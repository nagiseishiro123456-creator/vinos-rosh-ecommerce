# =========================================================
# LOCAL DATABASE (development)
# =========================================================
# Docker Compose reads POSTGRES_* values below.
POSTGRES_DB="vinos_rosh"
POSTGRES_USER="vinos_rosh_dev"
POSTGRES_PASSWORD="change-local-password"
DATABASE_URL="postgresql://vinos_rosh_dev:change-local-password@localhost:5432/vinos_rosh?schema=public"

# =========================================================
# APPLICATION
# =========================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"

# Opt-in for npm run dev + loopback app/DB only. Production keeps 6 registrations/hour.
LOCAL_REGISTRATION_TEST_MODE="false"

# Development-only visual catalog when the database has no real products.
# Keep false in production.
SHOW_DEMO_CATALOG="false"
# Prevent indexing when deploying a public validation/staging environment.
PREVIEW_MODE="false"

# Public contact / analytics
NEXT_PUBLIC_WHATSAPP_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Deadline for NEW unpaid manual reservations only; existing deadlines are persisted.
# Safe range enforced by the app: 15 to 1440 minutes.
MANUAL_PAYMENT_HOLD_MINUTES="120"

# =========================================================
# INITIAL ADMIN (development seed only)
# Never use example credentials in production.
# =========================================================
ADMIN_EMAIL="admin@vinosrosh.local"
ADMIN_PASSWORD="replace-with-a-strong-local-password"
ADMIN_FIRST_NAME="Administrador"
ADMIN_LAST_NAME="ROSH"

# =========================================================
# CLOUDINARY
# =========================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =========================================================
# PAYMENTS
# =========================================================
PAYMENTS_CULQI_ENABLED="false"
PAYMENTS_YAPE_MANUAL_ENABLED="true"

# Protected preparation/reservation APIs exist; checkout activation is still pending.
# Read-only status queries do not require these initiation flags.
# Mi Cuenta Web V4 TEST credentials are different from Punto Web SDK credentials.
# TEST below is a local guard; use only credentials Izipay issued for testing.
PAYMENTS_IZIPAY_ENABLED="false"
# Separate opt-in for the preparation endpoint. Keep off until the sandbox contract is verified.
IZIPAY_MCW_INITIATE_ENABLED="false"
# Independent opt-in for authenticated TEST reservations; does not initiate a charge.
IZIPAY_MCW_RESERVE_ENABLED="false"
IZIPAY_INTEGRATION=""
IZIPAY_MODE="TEST"
IZIPAY_MCW_MERCHANT_ID=""
IZIPAY_MCW_REST_TEST_PASSWORD=""
IZIPAY_MCW_PUBLIC_TEST_KEY=""
# Used for the browser-return context only, not the server-to-server IPN.
IZIPAY_MCW_BROWSER_HMAC_TEST_KEY=""
PAYMENTS_TRANSFER_MANUAL_ENABLED="true"

CULQI_PUBLIC_KEY=""
CULQI_SECRET_KEY=""
CULQI_WEBHOOK_SECRET=""

YAPE_PHONE=""
YAPE_QR_IMAGE_URL=""
BANK_ACCOUNT_LABEL=""
BANK_ACCOUNT_NUMBER=""

# =========================================================
# EMAIL / RESEND
# =========================================================
RESEND_API_KEY=""
EMAIL_FROM="Vinos ROSH <no-reply@example.com>"
